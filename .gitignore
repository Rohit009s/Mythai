# Dependencies
node_modules/
frontend/node_modules/
server/node_modules/
mcp-server/node_modules/

# Environment variables (contains API keys and secrets)
.env
.env.local
.env.production
.env.development
frontend/.env*
server/.env*

# IDE and Editor files
/.vscode/
.idea/
.kiro/
kiro/
*.swp
*.swo

# Build outputs
dist/
build/
frontend/dist/
server/dist/

# Data files (large files excluded)
data/voices/
data/embeddings/*.json
!data/embeddings/.gitkeep

# Audio files
audio/
*.wav
*.mp3
*.ogg
*.m4a

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS files
.DS_Store
Thumbs.db
*.tmp
*.temp

# Python cache (for TTS service)
__pycache__/
*.pyc
*.pyo

# Model cache
.cache/
models/

# Deployment files
.vercel/
.netlify/

# Package manager lock files (keep package-lock.json but ignore others)
yarn.lock
pnpm-lock.yaml

# Test coverage
coverage/
.nyc_output/

# Runtime data
pids/
*.pid
*.seed
*.pid.lock
